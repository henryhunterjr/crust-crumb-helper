{
  "manifest_version": 3,
  "name": "Krusty Skool Helper",
  "version": "2.1.0",
  "description": "Safely paste messages for review and capture loaded Skool introductions for the Crust & Crumb Member Compass.",
  "permissions": ["clipboardRead", "clipboardWrite", "activeTab", "storage"],
  "host_permissions": ["https://www.skool.com/*", "https://skoo.ly/*"],
  "content_scripts": [
    {
      "matches": ["https://www.skool.com/*", "https://skoo.ly/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Krusty Skool Helper",
    "default_popup": "popup.html"
  }
}
