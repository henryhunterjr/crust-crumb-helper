{
  "manifest_version": 3,
  "name": "Krusty Skool Helper",
  "version": "2.0.1",
  "description": "Review and paste Crust & Crumb messages into the verified Skooly or Skool conversation. Sending always stays intentional.",
  "permissions": ["clipboardRead", "activeTab", "storage"],
  "host_permissions": ["https://www.skool.com/*", "https://skoo.ly/*"],
  "content_scripts": [
    {
      "matches": ["https://www.skool.com/*", "https://skoo.ly/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Krusty Skool Helper",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": { "48": "icon.png", "128": "icon.png" }
}
